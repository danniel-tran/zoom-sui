generator client {
  provider = "prisma-client-js"
  output   = "../src/db/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ApprovalRequest {
  id                String        @id @default(cuid())
  room_id           String        @db.VarChar(66)
  requester_address String        @db.VarChar(100)
  status            String        @default("pending")
  created_at        DateTime      @default(now()) @db.Timestamp(6)
  resolved_at       DateTime?     @db.Timestamp(6)
  resolver_address  String?       @db.VarChar(100)
  meeting_rooms     meeting_rooms @relation(fields: [room_id], references: [room_id], onDelete: Cascade, onUpdate: NoAction)

  @@index([requester_address], map: "ApprovalRequest_requesterAddress_idx")
  @@index([room_id], map: "ApprovalRequest_roomId_idx")
  @@index([status])
}

model AuthNonce {
  id            String    @id @default(cuid())
  walletAddress String    @db.VarChar(100)
  nonce         String    @db.VarChar(255)
  expiresAt     DateTime  @db.Timestamp(6)
  consumedAt    DateTime? @db.Timestamp(6)
  createdAt     DateTime  @default(now()) @db.Timestamp(6)

  @@index([expiresAt])
  @@index([walletAddress])
}

/// DelegatedSignature - audit log for backend auto-signed actions
/// No scope system - blockchain validates all operations
/// Tracks: action, roomId, txDigest, timestamp for auditing
model DelegatedSignature {
  id        String   @id @default(cuid())
  sessionId String
  action    String   @db.VarChar(128) // e.g., "approve_guest", "start_room", "end_room"
  roomId    String?  @db.VarChar(66) // Room object ID (nullable for non-room actions)
  txDigest  String?  @db.VarChar(128) // Transaction digest (nullable if tx failed)
  signature String   @db.VarChar(1024) // The actual signature
  createdAt DateTime @default(now()) @db.Timestamp(6)
  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([sessionId])
  @@index([action])
  @@index([roomId])
  @@index([createdAt])
}

model RefreshToken {
  id              String    @id @default(cuid())
  sessionId       String    @unique
  tokenHash       String    @db.VarChar(255)
  expiresAt       DateTime  @db.Timestamp(6)
  revokedAt       DateTime? @db.Timestamp(6)
  rotationCounter Int       @default(0)
  createdAt       DateTime  @default(now()) @db.Timestamp(6)
  Session         Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([expiresAt])
  @@index([sessionId])
}

model Session {
  id                  String               @id @default(cuid())
  userId              String
  walletId            String
  jwtId               String               @db.VarChar(255)
  status              String               @default("active") @db.VarChar(32)
  createdAt           DateTime             @default(now()) @db.Timestamp(6)
  expiresAt           DateTime             @db.Timestamp(6)
  lastUsedAt          DateTime             @default(now()) @db.Timestamp(6)
  encryptedPrivateKey String?
  DelegatedSignature  DelegatedSignature[]
  RefreshToken        RefreshToken?
  User                User                 @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  Wallet              Wallet               @relation(fields: [walletId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([expiresAt])
  @@index([jwtId])
  @@index([status])
  @@index([userId])
  @@index([walletId])
}

model User {
  id                   String    @id @default(cuid())
  primaryWalletAddress String?   @db.VarChar(100)
  createdAt            DateTime  @default(now()) @db.Timestamp(6)
  updatedAt            DateTime  @default(now()) @db.Timestamp(6)
  Session              Session[]
  Wallet               Wallet[]

  @@index([primaryWalletAddress])
}

model Wallet {
  id        String    @id @default(cuid())
  userId    String
  address   String    @unique @db.VarChar(100)
  type      String    @default("sui") @db.VarChar(32)
  status    String    @default("active") @db.VarChar(32)
  createdAt DateTime  @default(now()) @db.Timestamp(6)
  updatedAt DateTime  @default(now()) @db.Timestamp(6)
  Session   Session[]
  User      User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([address])
  @@index([userId])
}

model diesel_schema_migrations {
  version String   @id @db.VarChar(50)
  run_on  DateTime @default(now()) @db.Timestamp(6)

  @@map("__diesel_schema_migrations")
}

model meeting_rooms {
  id                         BigInt              @id @default(autoincrement())
  room_id                    String              @unique @db.VarChar(66)
  title                      String
  hosts                      String[]            @default([])
  seal_policy_id             String              @unique @db.VarChar(66)
  status                     Int                 @default(1) @db.SmallInt
  max_participants           BigInt
  require_approval           Boolean             @default(false)
  participant_count          Int                 @default(0)
  created_at                 BigInt
  started_at                 BigInt?
  ended_at                   BigInt?
  checkpoint_sequence_number BigInt
  transaction_digest         String              @db.VarChar(64)
  indexed_at                 DateTime            @default(now()) @db.Timestamp(6)
  updated_at                 DateTime            @default(now()) @db.Timestamp(6)
  ApprovalRequest            ApprovalRequest[]
  room_metadata              room_metadata?
  room_participants          room_participants[]

  @@index([checkpoint_sequence_number], map: "idx_meeting_rooms_checkpoint")
  @@index([created_at(sort: Desc)], map: "idx_meeting_rooms_created_at")
  @@index([hosts], map: "idx_meeting_rooms_hosts", type: Gin)
  @@index([seal_policy_id], map: "idx_meeting_rooms_seal_policy_id")
  @@index([status], map: "idx_meeting_rooms_status")
  @@index([status, created_at(sort: Desc)], map: "idx_meeting_rooms_status_created")
}

model room_metadata {
  id                BigInt        @id @default(autoincrement())
  room_id           String        @unique @db.VarChar(66)
  dynamic_field_id  String        @unique @db.VarChar(66)
  df_version        BigInt
  language          String
  timezone          String
  recording_blob_id Decimal?      @db.Decimal(78, 0)
  indexed_at        DateTime      @default(now()) @db.Timestamp(6)
  updated_at        DateTime      @default(now()) @db.Timestamp(6)
  meeting_rooms     meeting_rooms @relation(fields: [room_id], references: [room_id], onDelete: Cascade, onUpdate: NoAction)

  @@index([dynamic_field_id], map: "idx_room_metadata_df_id")
  @@index([room_id], map: "idx_room_metadata_room")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model room_participants {
  id                  BigInt        @id @default(autoincrement())
  room_id             String        @db.VarChar(66)
  participant_address String        @db.VarChar(66)
  role                String        @db.VarChar(20)
  admin_cap_id        String?       @db.VarChar(66)
  joined_at           DateTime      @default(now()) @db.Timestamp(6)
  updated_at          DateTime      @default(now()) @db.Timestamp(6)
  meeting_rooms       meeting_rooms @relation(fields: [room_id], references: [room_id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([room_id, participant_address])
  @@index([participant_address], map: "idx_room_participants_address")
  @@index([room_id, role], map: "idx_room_participants_role")
  @@index([room_id], map: "idx_room_participants_room")
  @@index([participant_address, room_id], map: "idx_room_participants_user_rooms")
}

model watermarks {
  pipeline                  String   @id
  epoch_hi_inclusive        BigInt
  checkpoint_hi_inclusive   BigInt
  tx_hi                     BigInt
  timestamp_ms_hi_inclusive BigInt
  reader_lo                 BigInt
  pruner_timestamp          DateTime @db.Timestamp(6)
  pruner_hi                 BigInt
}
