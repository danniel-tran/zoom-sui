# ============================================================================
# SuiMeet Backend Environment Configuration
# ============================================================================
# Copy this file to .env and fill in the values
# NEVER commit .env to version control!
# ============================================================================

# ----------------------------------------------------------------------------
# Sui Blockchain Configuration
# ----------------------------------------------------------------------------

# SUI_PACKAGE_ID: The deployed SuiMeet Move package ID on Sui blockchain
# Format: 0x followed by 64 hexadecimal characters
# How to get: After deploying Move package, copy the package ID from output
# Example: 0x868d1e6293e193431b75814779abe4ec16c2ccc79f9010134195dc376772767b
SUI_PACKAGE_ID=0x868d1e6293e193431b75814779abe4ec16c2ccc79f9010134195dc376772767b

# REGISTRY_OBJECT_ID: The shared RoomRegistry object ID created at package init
# Format: 0x followed by 64 hexadecimal characters
# How to get: After package deployment, find the RoomRegistry object in transaction output
# Required for: Host actions (end room, etc.)
# Example: 0x1234567890abcdef1234567890abcdef1234567890abcdef1234567890abcdef
REGISTRY_OBJECT_ID=

# SUI_NETWORK: Which Sui network to connect to
# Options: testnet, devnet, mainnet, localnet
# Default: testnet
# Production should use mainnet
SUI_NETWORK=testnet

# SUI_CLOCK_OBJECT_ID: Standard Sui Clock object (DO NOT CHANGE)
# This is a constant for all Sui networks
SUI_CLOCK_OBJECT_ID=0x6

# ----------------------------------------------------------------------------
# Node Environment
# ----------------------------------------------------------------------------

# NODE_ENV: Application environment
# Options: development, production, test
# Affects logging, error handling, and security features
NODE_ENV=development

# ----------------------------------------------------------------------------
# Database Configuration
# ----------------------------------------------------------------------------

# PostgreSQL credentials for the indexer database
POSTGRES_USER=suimeet
POSTGRES_PASSWORD=suimeet_password
POSTGRES_DB=suimeet_indexer

# DATABASE_URL: Full PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# Used by Prisma for database operations
DATABASE_URL=postgresql://suimeet:suimeet_password@127.0.0.1:5432/suimeet_indexer

# SHADOW_DATABASE_URL: Temporary database for Prisma migrations
# Format: Same as DATABASE_URL
# Prisma uses this to safely test migrations before applying
SHADOW_DATABASE_URL=postgresql://suimeet:suimeet_password@127.0.0.1:5433/suimeet_shadow

# ----------------------------------------------------------------------------
# Encryption & Security (CRITICAL!)
# ----------------------------------------------------------------------------

# ENCRYPTION_KEY: Master key for encrypting ephemeral Ed25519 private keys
# Algorithm: AES-256-GCM (authenticated encryption)
# Format: 64 hexadecimal characters (32 bytes)
#
# REQUIRED: Generate with: openssl rand -hex 32
#
# SECURITY WARNINGS:
# - NEVER commit this to version control!
# - Store in secure secrets manager in production
# - Rotate periodically (requires re-encryption of all sessions)
# - If lost, all encrypted ephemeral keys become unusable
#
# Example generation:
#   openssl rand -hex 32
#   Output: 4be1165d08bf891c918d2b6575aef2bfa9b76911d79c46d82b918d7739615f83
#
ENCRYPTION_KEY=

# ----------------------------------------------------------------------------
# JWT (JSON Web Token) Configuration
# ----------------------------------------------------------------------------

# JWT_SECRET: Secret key for signing JWT access tokens
# Format: Any strong random string (recommend 64+ characters)
# Generate with: openssl rand -base64 64
#
# SECURITY:
# - NEVER commit to version control!
# - Rotate regularly (invalidates all existing tokens)
# - Use different secret for production vs development
#
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# JWT_EXPIRES_IN: Access token expiration time
# Format: String with time unit (s, m, h, d)
# Examples: 15m, 1h, 7d
# Recommended: 1h (balance between security and UX)
# Shorter = more secure, but more frequent refresh needed
JWT_EXPIRES_IN=1h

# REFRESH_TOKEN_EXPIRES_IN: Refresh token expiration time (in seconds)
# Format: Integer (seconds)
# Default: 604800 (7 days)
# Recommended: 7-30 days
# Allows user to stay logged in without re-authenticating
REFRESH_TOKEN_EXPIRES_IN=604800

# ----------------------------------------------------------------------------
# Session Configuration
# ----------------------------------------------------------------------------

# SESSION_MAX_AGE: Maximum session lifetime (in milliseconds)
# Format: Integer (milliseconds)
# Default: 86400000 (24 hours)
# After this time, ephemeral keys expire and user must re-authenticate
# Longer = better UX, but keys remain valid longer
# Shorter = more secure, but more frequent re-authentication
SESSION_MAX_AGE=86400000

# EPHEMERAL_KEY_EXPIRES_IN: Ephemeral key expiration (in milliseconds)
# Format: Integer (milliseconds)
# Default: 86400000 (24 hours)
# Same as SESSION_MAX_AGE - ephemeral keys tied to session lifetime
# Note: SessionKeys created from ephemeral keys have separate TTL (30 min)
EPHEMERAL_KEY_EXPIRES_IN=86400000

# ----------------------------------------------------------------------------
# Server Configuration
# ----------------------------------------------------------------------------

# PORT: Backend server port
# Default: 4000
# Frontend expects backend on this port (check NEXT_PUBLIC_API_URL in frontend .env)
PORT=4000

# CORS_ORIGIN: Allowed origins for CORS (Cross-Origin Resource Sharing)
# Format: Comma-separated list of URLs (no trailing slash)
# Examples:
#   Development: http://localhost:3000
#   Production: https://suimeet.io,https://app.suimeet.io
#
# Security: Only allow trusted frontend origins
CORS_ORIGIN=http://localhost:3000

# ----------------------------------------------------------------------------
# Deployment Notes
# ----------------------------------------------------------------------------
#
# 1. Production Checklist:
#    - Set NODE_ENV=production
#    - Use strong ENCRYPTION_KEY (never reuse dev key!)
#    - Use strong JWT_SECRET (never reuse dev secret!)
#    - Set production DATABASE_URL (managed PostgreSQL)
#    - Set production CORS_ORIGIN (your domain)
#    - Enable HTTPS (required for production)
#    - Set up database backups
#    - Enable rate limiting
#    - Set up monitoring and alerts
#
# 2. Secrets Management:
#    - Use environment-specific .env files (.env.production, .env.staging)
#    - Store secrets in: AWS Secrets Manager, HashiCorp Vault, or similar
#    - Never commit .env files to version control
#    - Add .env to .gitignore
#
# 3. Database Migrations:
#    Development:  npx prisma migrate dev
#    Production:   npx prisma migrate deploy
#
# 4. Required Setup Steps:
#    a. Generate ENCRYPTION_KEY: openssl rand -hex 32
#    b. Generate JWT_SECRET: openssl rand -base64 64
#    c. Deploy Move package to get SUI_PACKAGE_ID
#    d. Find REGISTRY_OBJECT_ID in deployment transaction
#    e. Setup PostgreSQL database
#    f. Run migrations: npx prisma migrate deploy
#    g. Generate Prisma client: npx prisma generate
#
# ============================================================================
